// Template for Config/Secrets.xcconfig (which is git-ignored).
//
// Either copy this file to Secrets.xcconfig and fill in the key, or put the
// key in .env (REVENUECAT_APPLE_API_KEY=...) and run scripts/gen-secrets.sh.
//
// This is the RevenueCat *public* Apple SDK key — it looks like `appl_...`.
// Never put the RevenueCat *secret* key (`sk_...`) in the app.
REVENUECAT_APPLE_API_KEY = appl_YOUR_PUBLIC_SDK_KEY
